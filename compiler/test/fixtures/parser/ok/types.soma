def id [a : Sort] (x : a) : a := x

def arrow : A -> B -> C := f

def dependent : (x : A) -> B x := f

def grouped : (A -> B) -> C := f

def applied : List (A -> B) := f x (g y) 1 "s"

def implicit : [a : Sort] -> a -> a := id

def grouped_names : [a, b : Sort] -> (x, y : a) -> a := f

def body : Sort := [a : Sort] -> a
