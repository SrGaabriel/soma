// expect: success
// Test: higher-order functions - callClosure lowering

@[intrinsic "primop.add"]
def {+} : Int32 -> Int32 -> Int32

@[intrinsic "primop.mul"]
def {*} : Int32 -> Int32 -> Int32

def comp : (Int32 -> Int32) -> (Int32 -> Int32) -> Int32 -> Int32
    | f g, x  => f (g x)

def double : Int32 -> Int32
    | x => x + x

def square : Int32 -> Int32
    | x => x * x

def test : Int32 := comp double square 3
