// expect: success
// Test: binary operations - OP2 node lowering

@[intrinsic "primop.add"]
def {+} : Int -> Int -> Int

@[intrinsic "primop.sub"]
def {-} : Int -> Int -> Int

@[intrinsic "primop.mul"]
def {*} : Int -> Int -> Int

def add : Int -> Int -> Int
    | x, y  => x + y

def sub : Int -> Int -> Int
    | x, y  => x - y

def mul : Int -> Int -> Int
    | x, y  => x * y

def test1 : Int = add 3 4
def test2 : Int = mul (add 2 3) 4
