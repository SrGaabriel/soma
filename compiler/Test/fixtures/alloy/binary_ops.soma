// expect: success
// Test: binary operations - OP2 node lowering

@[intrinsic "primop.add"]
def {+} : Int32 -> Int32 -> Int32

@[intrinsic "primop.sub"]
def {-} : Int32 -> Int32 -> Int32

@[intrinsic "primop.mul"]
def {*} : Int32 -> Int32 -> Int32

def add : Int32 -> Int32 -> Int32
    | x, y  => x + y

def sub : Int32 -> Int32 -> Int32
    | x, y  => x - y

def mul : Int32 -> Int32 -> Int32
    | x, y  => x * y

def test1 : Int32 = add 3 4
def test2 : Int32 = mul (add 2 3) 4
