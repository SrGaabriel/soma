// expect: success
// Test: recursive data type - REF/ALO node lowering

inductive List {a : Type} where
    | Nil
    | Cons (head : a) (tail : List a)

def head :  a. a -> List a -> a
    | default, Nil  => default
    | _ (Cons x, _)  => x

def tail :  a. List a -> List a
    | Nil => Nil
    | (Cons _ xs) => xs

def test : Int = head 0 Nil
