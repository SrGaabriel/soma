// expect: success
// Test: variable used multiple times - DUP chain lowering

@[intrinsic "primop.add"]
def {+} : Int -> Int -> Int

def use_thrice : Int -> Int
    | x => x + x + x

def use_twice : Int -> (Int, Int)
    | x => (x, x)

def test1 : Int = use_thrice 10
def test2 : (Int, Int) = use_twice 42
