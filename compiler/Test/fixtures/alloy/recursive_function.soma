// expect: success
// Test: recursive function - self REF lowering

inductive Nat where
    | Zero
    | Succ (pred : Nat)

def is_zero : Nat -> Int32
    | Zero => 1
    | (Succ _) => 0

def pred : Nat -> Nat
    | Zero => Zero
    | (Succ n) => n

def one : Nat = Succ Zero
def two : Nat = Succ (Succ Zero)
def test : Int32 = is_zero one
