// expect: success
// Test: pattern matching on ADT - MAT node lowering

inductive Color where
    | Red
    | Green
    | Blue

def to_int : Color -> Int32
    | Red => 0
    | Green => 1
    | Blue => 2

def test1 : Int32 := to_int Red
def test2 : Int32 := to_int Green
def test3 : Int32 := to_int Blue
