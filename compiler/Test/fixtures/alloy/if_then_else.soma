// expect: success
// Test: if-then-else - branch terminator lowering

inductive MyBool where
    | MyTrue
    | MyFalse

def choose : MyBool -> Int32 -> Int32 -> Int32
    | MyTrue x, _  => x
    | MyFalse _, y  => y

def max : Int32 -> Int32 -> Int32
    | x, y  => choose MyTrue x y

def test : Int32 = max 10 20
