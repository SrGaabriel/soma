// expect: success
// Test: mutually recursive functions - cross REF lowering

inductive Nat where
    | Zero
    | Succ (pred : Nat)

def is_even : Nat -> Int
    | Zero => 1
    | (Succ n) => is_odd n

def is_odd : Nat -> Int
    | Zero => 0
    | (Succ n) => is_even n

def test : Int = is_even (Succ (Succ Zero))
