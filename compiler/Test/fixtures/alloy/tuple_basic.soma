// expect: success
// Test: tuple creation and projection - pair lowering

def pair : (Int32, Int32) := (42, 17)

def fst : (Int32, Int32) -> Int32
    | (x, _) => x

def snd : (Int32, Int32) -> Int32
    | (_, y) => y

def swap : (Int32, Int32) -> (Int32, Int32)
    | (a, b) => (b, a)

def test1 : Int32 := fst pair
def test2 : Int32 := snd (swap pair)
