def point : { x : Int, y :: Int } = { x = 10, y = 20 }

def get_x : { x : Int, y :: Int } -> Int
    | p => p.x

def get_y : { x : Int, y :: Int } -> Int
    | p => p.y

def test1 : Int = get_x point
def test2 : Int = get_y point
