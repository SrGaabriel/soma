// Test: record creation and field access - struct lowering

def point : { x : Int32, y :: Int32 } := { x := 10, y := 20 }

def get_x : { x : Int32, y :: Int32 } -> Int32
    | p => p.x

def get_y : { x : Int32, y :: Int32 } -> Int32
    | p => p.y

def test1 : Int32 := get_x point
def test2 : Int32 := get_y point
