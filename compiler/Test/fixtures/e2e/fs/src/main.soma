use stdlib::fs::{from_string, create, write, read_to_string, close, remove, open}

def main : IO () :=
    compose
        let path := from_string "test_output.txt"

        bind fh <- create path
        write fh "Hello from Soma!\nLine 2"
        close fh

        bind fh2 <- open path "r"
        bind contents <- read_to_string fh2
        close fh2

        puts contents

        remove path
        puts "Done!"
