def lambdaIndented (x : Int32) : Int32 :=
  \y ->
    y + x

def ifElseAligned (x : Int32) : Int32 :=
  if x <= 0 then 0
  else x

def ifThenIndented (x : Int32) : Int32 :=
  if x <= 0 then
    0
  else
    x

def letInAligned : Int32 :=
  let x := 1
  in x + 1

def letBodyIndented : Int32 :=
  let x := 1 in
    x + 1

def arrowContinuation :
  Int32 ->
  Int32 :=
  \x -> x

def arrowChain :
  Int32 ->
  Int32 ->
  Int32 :=
  \x y -> x + y

def doubleColonContinuation : Int32 :=
  (1 ::
    Int32) + 0
