// expect: success
// Test: named instance syntax
// Instances can be given explicit names: `instance myName : class Type where ...`

class Showable (a : Type) where
    render : a -> String

// Named instance - can be referenced by name later
instance intShowable : Showable Int32 where
    def render
        | x => "int"

// Unnamed instance also works
instance : Showable Bool where
    def render
        | b => "bool"

def display (a : Type) : {{Showable a}} -> a -> String
    | x => render x
