// expect: success
// Test: row polymorphism - accessing fields in extensible records

def get_x : ∀ (r : Row). { x : Int32 | r } -> Int32
    | rec => rec.x

def test1 : Int32 := get_x { x := 1, y := 2 }
def test2 : Int32 := get_x { x := 42, z := true, w := "hello" }
def test3 : Int32 := get_x { x := 100 }
