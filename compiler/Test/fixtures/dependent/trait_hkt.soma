// expect: success
// Test: class with higher-kinded type parameter

class Functor (f :: Type -> Type) where
    def fmap :: forall a b. (a -> b) -> f a -> f b

def mapBoth :: forall (f :: Type -> Type) a b. (a -> b) -> f a -> f a -> (f b, f b) with (Functor f)
    | fn x y => (fmap fn x, fmap fn y)
