// expect: success
// Test: basic class instance

data Maybe a
    | Nothing
    | Just a

class Functor (f :: Type -> Type) where
    def fmap :: forall a b. (a -> b) -> f a -> f b

instance Functor Maybe where
    def fmap :: forall a b. (a -> b) -> Maybe a -> Maybe b
        | g (Maybe::Just value) => Maybe::Just (g value)
        | g Maybe::Nothing => Maybe::Nothing
