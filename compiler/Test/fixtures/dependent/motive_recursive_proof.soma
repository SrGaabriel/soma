// expect: success

inductive Nat where
    | Zero
    | Succ (n : Nat)

inductive Truth where
    | Trivial

inductive Never : Type

class Gt (a : Type) where
    gt : a -> a -> Type

instance Gt Nat where
    def gt : Nat -> Nat -> Type
        | Nat::Zero, Nat::Zero => Truth
        | Nat::Zero, Nat::Succ _ => Never
        | Nat::Succ _, Nat::Zero => Truth
        | Nat::Succ n, Nat::Succ m => gt n m

def adding_one_increases : (n : Nat) -> gt (Nat::Succ n) n
    | Nat::Zero => Truth::Trivial
    | Nat::Succ n => adding_one_increases n
