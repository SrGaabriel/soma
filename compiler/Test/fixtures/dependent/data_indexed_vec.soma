// expect: success
// Test: length-indexed vectors (Vec n a)

data Nat where
  | Zero :: Nat
  | Succ :: Nat -> Nat

data Vec n a where
  | Nil :: Vec Nat::Zero a
  | Cons :: a -> Vec m a -> Vec (Nat::Succ m) a

def emptyVec :: Vec Nat::Zero Int = Vec::Nil

def oneElem :: Vec (Nat::Succ Nat::Zero) Int = Vec::Cons 42 Vec::Nil

def twoElems :: Vec (Nat::Succ (Nat::Succ Nat::Zero)) Int = Vec::Cons 1 (Vec::Cons 2 Vec::Nil)
