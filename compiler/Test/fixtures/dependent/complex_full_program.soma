// expect: success
// Test: a complete program with multiple features

@[intrinsic]
def {+} : Int -> Int -> Int

inductive Maybe {a : Type} where
    | Nothing
    | Just (value : a)

def id : ∀ a. a -> a
    | x => x

def map : ∀ a b. (a -> b) -> Maybe a -> Maybe b
    | f, Maybe::Nothing => Maybe::Nothing
    | f, (Maybe::Just x) => Maybe::Just (f x)

def test1 : Int = id 42
def test2 : Maybe Int = Maybe::Just 100
def test3 : Maybe Int = map id (Maybe::Just 42)
