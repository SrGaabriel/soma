// expect: success
// Test: a complete program with multiple features

@[intrinsic]
def {+} :: Int -> Int -> Int

data Maybe a
    | Nothing
    | Just a

def id :: forall a. a -> a
    | x => x

def map :: forall a b. (a -> b) -> Maybe a -> Maybe b
    | f Nothing => Nothing
    | f (Just x) => Just (f x)

def test1 :: Int = id 42
def test2 :: Maybe Int = Just 100
def test3 :: Maybe Int = map id (Just 42)
