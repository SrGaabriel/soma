// expect: success
// Test: simple pair types with @[wired_in] attributes

inductive Pair {a : Type} {b : Type} where
    | MkPair (fst : a) (snd : b)

def pair : Pair Int Int = Pair::MkPair 1 2

def fst : Pair Int Int -> Int
    | Pair::MkPair x _ => x

def snd : Pair Int Int -> Int
    | Pair::MkPair _ y => y
