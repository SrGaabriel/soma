// expect: success

def handleResult :: < Ok :: Int | Err :: String > -> Int
    | .Ok n => n
    | .Err _ => 0

def test1 :: Int = handleResult (.Ok 42)
def test2 :: Int = handleResult (.Err "oops")

def unwrapOk :: < Ok :: Int | Err :: String > -> Int
    | .Ok n => n
    | .Err msg => 0

def test3 :: Int = unwrapOk (.Ok 100)
