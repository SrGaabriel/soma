// expect: success

def handle_result : < Ok::Int32 | Err :: String > -> Int32
    | .Ok n => n
    | .Err _ => 0

def test1 : Int32 = handle_result (.Ok 42)
def test2 : Int32 = handle_result (.Err "oops")

def unwrap_ok : < Ok::Int32 | Err :: String > -> Int32
    | .Ok n => n
    | .Err msg => 0

def test3 : Int32 = unwrap_ok (.Ok 100)
