// expect: success

def getX :: forall (r :: Row). { x :: Int | r } -> Int
    | rec => rec.x

def getName :: forall (r :: Row). { name :: String | r } -> String
    | rec => rec.name

def test1 :: Int = getX { x = 42 }
def test2 :: Int = getX { x = 1, y = 2 }
def test3 :: Int = getX { x = 100, y = "hello", z = true }

def test4 :: String = getName { name = "alice" }
def test5 :: String = getName { name = "bob", age = 30 }

def getBoth :: forall (r :: Row). { x :: Int, name :: String | r } -> (Int, String)
    | rec => (rec.x, rec.name)

def test6 :: (Int, String) = getBoth { x = 42, name = "test" }
def test7 :: (Int, String) = getBoth { x = 1, name = "extra", other = 999 }
