// expect: success

inductive Maybe {a : Type} where
    | Nothing
    | Just (value : a)

def identity :  (f : Type -> Type) a. f a -> f a
    | x => x

def identity_maybe : Maybe Int -> Maybe Int
    | x => identity x

def map_record :  (f : Type -> Type) (r : Row). { value : f Int | r } -> { value : f Int | r }
    | rec => rec

def map_maybe_record : { value : Maybe Int, name : String } -> { value : Maybe Int, name : String }
    | rec => map_record rec
