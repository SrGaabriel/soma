// expect: success

def get_field :  (l : Label) (a : Type) (r : Row). { l : a | r } -> a
    | rec => rec @l

def test1 : Int = get_field @x { x = 42, y = "hello" }

def test2 : String = get_field @name { name = "alice", age = 30 }

def test3 : Bool = get_field @active { id = 1, name = "test", active = true }

def rename :  (l1 : Label) (l2 : Label) (a : Type) (r : Row). { l1 : a | r } -> { l2 : a | r }
    | rec => { l2 = rec @l1 }

def test4 = rename @x @y { x = 42, z = true }

record Point where
    x : Int
    y : Int

def test5 : Int = get_field @x (Point 1 2)
def test6 : Int = get_field @y (Point 3 4)

def test7 : Int = get_field { x = 42 }
