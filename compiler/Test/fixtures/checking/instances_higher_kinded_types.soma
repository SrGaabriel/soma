// expect: success

@[intrinsic "primop.add"]
def {+} : Int32 -> Int32 -> Int32

inductive Maybe {a : Type} where
    | Nothing
    | Just (value : a)

class Functor (f : Type -> Type) where
    fmap : ∀ a b. (a -> b) -> f a -> f b

 instance : Functor Maybe where
    def fmap : (a -> b) -> Maybe a -> Maybe b
        | f (Just, value)  => Just (f value)
        | f, (Nothing)  => Nothing

def map_both : ∀ (f : Type -> Type) a b. {{Functor f}} -> (a -> b) -> f a -> f a -> (f b, f b)
    | fn x, y  => (fmap fn x, fmap fn y)

def test : (Maybe Int32, Maybe Int32) := map_both (\x => x + 1) (Just 1) (Just 2)
