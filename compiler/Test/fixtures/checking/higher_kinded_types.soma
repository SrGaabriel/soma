// expect: success

def identity :: forall (f :: Type -> Type) a. f a -> f a
    | x => x

def bimap :: forall (f :: Type -> Type -> Type) a b c d. (a -> c) -> (b -> d) -> f a b -> f c d
    | f g x => x

def fix :: forall (f :: (Type -> Type) -> Type) (g :: Type -> Type). f g -> f g
    | x => x

def mapRecord :: forall (f :: Type -> Type) (r :: Row). { value :: f Int | r } -> { value :: f Int | r }
    | rec => rec
