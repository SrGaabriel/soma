// expect: success

def identity :  (f : Type -> Type) a. f a -> f a
    | x => x

def bimap :  (f : Type -> Type -> Type) a b c d. (a -> c) -> (b -> d) -> f a b -> f c d
    | f g, x  => x

def fix :  (f : (Type -> Type) -> Type) (g : Type -> Type). f g -> f g
    | x => x

def map_record :  (f : Type -> Type) (r : Row). { value : f Int | r } -> { value : f Int | r }
    | rec => rec
