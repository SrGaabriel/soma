@[wired_in "type.int"]
inductive Int32 where
    | MkInt32

@[wired_in "type.bool"]
inductive Bool where
    | True
    | False

@[wired_in "type.string"]
record String where
    data : Ptr Word8
    len  : Int64

@[wired_in "type.unit"]
inductive Unit where
    | Unit

@[wired_in "type.int8"]
inductive Int8 where
    | MkInt8

@[wired_in "type.int16"]
inductive Int16 where
    | MkInt16

@[wired_in "type.int64"]
inductive Int64 where
    | MkInt64

@[wired_in "type.word8"]
inductive Word8 where
    | MkWord8

@[wired_in "type.word16"]
inductive Word16 where
    | MkWord16

@[wired_in "type.word"]
inductive Word32 where
    | MkWord32

@[wired_in "type.word64"]
inductive Word64 where
    | MkWord64

@[wired_in "type.float"]
inductive Float where
    | MkFloat

@[wired_in "type.double"]
inductive Double where
    | MkDouble

@[wired_in "type.pair"]
inductive Pair {a : Type} {b : Type} where
    @[wired_in "pair"]
    | MkPair (fst : a) (snd : b)

@[wired_in "type.list"]
inductive List {a : Type} where
    @[wired_in "nil"]
    | Nil
    @[wired_in "cons"]
    | Cons (head : a) (tail : List a)

@[wired_in "type.ptr"]
inductive Ptr {a : Type} where
    | MkPtr

@[wired_in "type.world"]
inductive World where
    | MkWorld

alias IO a := (1 w : World) -> Pair World a
