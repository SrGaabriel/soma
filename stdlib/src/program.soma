use base::prim::{IO, Int32, List, +, <=}
use base::string::{String}
use base::core::{>>=, pure}

@[extern "soma_argc"]
def argc : IO Int32

@[extern "soma_argv_at"]
def argv_at : Int32 -> IO String

def collect_args (i : Int32) (n : Int32) : IO (List String) :=
    if n <= i then pure List::Nil
    else argv_at i >>= (\arg ->
        collect_args (i + 1) n >>= (\rest ->
            pure (List::Cons arg rest)))

def get_args : IO (List String) :=
    argc >>= (\n -> collect_args 0 n)
