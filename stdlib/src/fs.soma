use base::core::{<>, >>=}
use base::ffi::{CString, CInt, CLong, from_cstring}
use base::io::{pure_io}
use base::prim::{Ptr, IO, Unit, Word8, Int32, Int64}
use base::string::{String}

@[intrinsic "primop.add"]
def add64 : Int64 -> Int64 -> Int64

record Path where
    value : String

def {</>} (p1 : Path) (p2 : Path) : Path :=
    let value1 := p1.value in
    let value2 := p2.value in
    Path::New (value1 <> "/" <> value2)

record FileHandle where
    ptr : Ptr Unit

@[extern "fopen"]
def c_fopen : CString -> CString -> IO (Ptr Unit)

@[extern "fclose"]
def c_fclose : Ptr Unit -> IO CInt

@[extern "fflush"]
def c_fflush : Ptr Unit -> IO CInt

@[extern "fputs"]
def c_fputs : CString -> Ptr Unit -> IO CInt

@[extern "fseek"]
def c_fseek : Ptr Unit -> CLong -> CInt -> IO CInt

@[extern "ftell"]
def c_ftell : Ptr Unit -> IO CLong

@[extern "fread"]
def c_fread : Ptr Word8 -> CLong -> CLong -> Ptr Unit -> IO CLong

@[extern "calloc"]
def c_calloc : CLong -> CLong -> IO (Ptr Word8)

@[extern "remove"]
def c_remove : CString -> IO CInt

def open (path : Path) (mode : String) : IO FileHandle := compose
    let cpath := path.value.bytes.data
    let cmode := mode.bytes.data
    bind handle <- c_fopen cpath cmode
    pure_io (FileHandle::New handle)

def close (handle : FileHandle) : IO CInt :=
    c_fclose (handle.ptr)

def create (path : Path) : IO FileHandle := open path "w"

def flush (handle : FileHandle) : IO CInt :=
    c_fflush (handle.ptr)

def write (handle : FileHandle) (content : String) : IO CInt := compose
    let ccontent := content.bytes.data
    c_fputs ccontent (handle.ptr)

def read_to_string (handle : FileHandle) : IO String := compose
    let ptr := handle.ptr
    c_fseek ptr (0 :: Int64) (2 :: Int32)
    bind size <- c_ftell ptr
    c_fseek ptr (0 :: Int64) (0 :: Int32)
    bind buf <- c_calloc (add64 size (1 :: Int64)) (1 :: Int64)
    c_fread buf (1 :: Int64) size ptr
    pure_io (from_cstring buf)

def remove (path : Path) : IO CInt := compose
    let cpath := path.value.bytes.data
    c_remove cpath
