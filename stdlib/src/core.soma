intrinsic def {+} :: Int -> Int -> Int
intrinsic def {-} :: Int -> Int -> Int
intrinsic def {*} :: Int -> Int -> Int
intrinsic def {%} :: Int -> Int -> Int
intrinsic def {/} :: Int -> Int -> Int

intrinsic def strcat :: String -> String -> String
intrinsic def int_to_string :: Int -> String

intrinsic def println :: a -> IO () with (Display a)
intrinsic def pureIO :: a -> IO a
intrinsic def pureIOSeq :: IO a -> (a -> IO b) -> IO b

intrinsic data IO :: * -> *

trait Display a where
    def display :: a -> String

data Option a
    | Some
        value :: a
    | None

data Either err ok
    | Err
        error :: err
    | Ok
        value :: ok

trait Semigroup a where
    def {<>} :: a -> a -> a

trait Monoid a with (Semigroup a) where
    def mempty :: a
    def mconcat :: [a] -> a

trait Functor f where
    def fmap :: (a -> b) -> f a -> f b

trait Applicative f with (Functor f) where
    def pure :: a -> f a
    def {<*>} :: f (a -> b) -> f a -> f b

    def {*>} :: f a -> f b -> f b
    def {<*} :: f a -> f b -> f a

trait Alternative f with (Applicative f) where
    def empty :: f a
    def {<|>} :: f a -> f a -> f a

trait Monad m with (Applicative m) where
    def {>>=} :: m a -> (a -> m b) -> m b
    def {>>} :: m a -> m b -> m b

trait Foldable t with (Monoid t) where
    def foldMap :: (a -> m) -> t a -> m with (Monoid m)
    def fold :: t m -> m

trait Traversable t with (Functor t, Foldable t) where
    def traverse :: (a -> f b) -> t a -> f (t b) with (Applicative f)
    def sequenceA :: t (f a) -> f (t a) with (Applicative f)

instance Functor Option where
    def fmap :: (a -> b) -> Option a -> Option b
        | f (Some value) => Some (f value)
        | f (None) => None

instance Display (Option a) with (Display a) where
    def display :: Option a -> String
        | (Some value) => "Some(" <> display value <> ")"
        | (None) => "None"

instance Display String where
    def display(str: String) -> String = str

instance Display Int where
    def display(n: Int) -> String = int_to_string n

instance Display [a] where
    def display(list: [a]) -> String = "<list>"

instance Functor IO where
    def fmap(f, ioA) :: (a -> b) -> IO a -> IO b =
        ioA >>= (\x -> pureIO (f x))

instance Applicative IO with (Functor IO) where
    def pure :: a -> IO a =
        pureIO

    def {<*>}(ioF, ioA) :: IO (a -> b) -> IO a -> IO b =
        ioF >>= (\f -> ioA >>= (\a -> pureIO (f a)))
    def {*>}(ioA, ioB) :: IO a -> IO b -> IO b =
        ioA >>= (\a -> ioB)
    def {<*}(ioA, ioB) :: IO a -> IO b -> IO a =
        ioA >>= (\a -> ioB >>= (\b -> pureIO a))

instance Semigroup String where
    def {<>}(s1: String, s2: String) -> String = strcat s1 s2

intrinsic instance Monad IO with (Applicative IO)
