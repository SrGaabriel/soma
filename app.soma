struct Shape a
    = Point
        x :: a
        y :: a
    | Circle
        radius :: Int

struct Applier (a :: * -> *)
    = Applier
        func :: a Int

class Functor (f :: * -> *) specifies
    fmap :: (a -> b) -> f a -> f b

nothing :: Int = (5+5)*5

hello :: String =
    "Hello, " + "World!"

test :: Int =
    5 + sum 5 6 + 7

variables :: Int =
    let first = 5 in
    let second = 6 in
    identity $ do
        8 + 9 + 10
        right first $ genericId $ sum first $ second + first

sum (a b) :: Int -> Int -> Int = a + b

combine :: f a -> g b -> h c
  where f: Functor = 0