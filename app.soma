nothing :: Int = (5+5)*5

hello :: String =
    "Hello, " + "World!"

test :: Int =
    5 + sum 5 6 + 7

variables :: Int =
    let first = 5 in
    let second = 6 in
    identity $ do
        8 + 9 + 10
        right first $ genericId $ sum first $ second + first

sum (a b) :: Int -> Int -> Int =
    a + b
