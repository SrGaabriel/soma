trait Eq a where
    def {==} :: a -> a -> Bool

def sum(x: Int, y: Int) -> Int = x + y

instance Eq Int where
    def {==}(x: Int, y: Int) -> Bool = true

def isZero :: Int -> Int -> Bool
  | a 0 => true
  | 0 b => true
  | _ _ => false

data Shape
    = Square
        length :: Int
    | Circle
        radius :: Int

instance Eq Shape where
    def eq :: Shape -> Shape -> Bool
      | (Circle x) (Circle y) => x == y
      | (Square x) (Square y) => x == y
      | (Circle x) (Square y) => x == y
      | (Square x) (Circle y) => x == y