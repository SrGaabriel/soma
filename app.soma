trait Eq a where
    def equals :: a -> a -> Bool

def chooseRight :: a -> a -> a
    | lhs rhs => rhs

intrinsic def {+} :: Int -> Int -> Int

def isZero :: Int -> Bool
    | 0 => true
    | _ => false

instance Eq Int where
    def equals(x: Int, y: Int) -> Bool = true

data Shape
    = Square
        length :: Int
    | Circle
        radius :: Int

instance Eq Shape where
    def equals :: Shape -> Shape -> Bool
        | (Circle r1) (Circle r2) => equals r1 r2
        | (Square s1) (Square s2) => true
        | _         _             => false

def testSum(x: Int, y: Int) -> Int = x + y

def areNumEqual(num1: Int, num2: Int) -> Bool = equals num1 num2

def testShape :: Shape = Circle 5

def experimentChooseRight :: a -> b -> b
    | lhs rhs => rhs

def testChoose :: a -> b -> b
    | lhs rhs => experimentChooseRight lhs rhs

def genericEq :: a -> a -> Bool where a: Eq
    | x y => equals x y

def genericEqTest :: a -> a -> Bool where a: Eq
    | x y => genericEq x y