struct Shape[a]
    = Point
        x :: a
        y :: a
    | Circle
        radius :: Int

class Display a where
    display :: a -> String
    display2 :: a -> String

fibonacci n :: Int -> String
  | 0 -> 0
  | 1 -> 1
  | n -> fibonacci(n-1) + fibonacci(n-2)

nothing :: Int = (5+5)*5

hello :: String =
    "Hello, " + "World!"

test :: Int =
    5 + sum 5 6 + 7

variables :: Int =
    let first = 5 in
    let second = 6 in
    identity $ do
        8 + 9 + 10
        right first $ genericId $ sum first $ second + first

sum (a b) :: Int -> Int -> Int =
    a + b

structVariantTest :: Shape[Int] = 
    (Point 5 12)

complexStructTest :: Int = 
    genericStructId (Point 20 32) 5

genericStructId (a b) :: Shape[c] -> c -> c = b

identity (a) :: Int -> Int = a

genericId x :: a -> a = x

genericTest :: Int =
    genericId $ right 5 6

emoji🤩Test :: Int =
    let 💀 = 6 in
    let ➕ = 12 in
    let 😱wow😡 = 18 in
    sum 💀 ➕ * 😱wow😡

right (lhs rhs) :: a -> a -> a = genericId $ lhs

tuplesTest :: (Boolean, String, Boolean) =
    (false, "Hello, World!", true)

tripleTupleTest :: (Int, Int, Int) =
    tripleTuple 5 6 7

polymorphicTripleTupleTest value :: b -> (Int, b, Int) =
    tripleTuple 21 value 24

tripleTuple (a b c) :: first -> second -> third -> (first, second, third) =
    (a, b, c)

groupingTest predicate :: (Int -> Int) -> Int = 0

emptyTupleTest :: () = ()

`quoted name test` :: Int = 5

addNumbers[a : Type] value :: Shape[a] -> String = ""

lambda :: (Int -> Int) = (\n -> n)

predicate (val pred) :: a -> (a -> Bool) -> Bool = pred val

predicateTest :: Bool = predicate 5 (λval -> true)

doublePredicate (x y pred) :: a -> b -> (a -> b -> Int) -> Int =
    pred x y

doublePredicateTest :: Int =
    doublePredicate 5 6 (λx.y -> x + y)

multilineStrings :: String = """Hello,
World!"""