struct Shape[a]
    = Point
        x :: a
        y :: a
    | Circle
        radius :: Int

fibonacci n :: Int -> String
  | 0 -> 0
  | 1 -> 1
  | n -> fibonacci(n-1) + fibonacci(n-2)

nothing :: Int = (5+5)*5

hello :: String =
    "Hello, " + "World!"

test :: Int =
    5 + sum 5 6 + 7

variables :: Int =
    let first = 5 in
    let second = 6 in
    identity $ do
        8 + 9 + 10
        right first $ genericId $ sum first $ second + first

sum a b :: Int Int -> Int =
    a + b

structVariantTest :: Shape[Int] = 
    (Point 5 12)

complexStructTest :: Int = 
    genericStructId (Point 5 12)

genericStructId a :: Shape[c] -> c = a

identity a :: Int -> Int = a

genericId x :: a -> a = x


genericTest :: Int =
    genericId $ right 5 6

right lhs rhs :: a a -> a = genericId $ lhs