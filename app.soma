fibonacci :: (Int) -> Int
  | 0 -> 0
  | 1 -> 1
  // | n -> fibonacci(n-1) + fibonacci(n-2)

nothing :: Int = (5+5)*5

hello :: String =
    "Hello, " + "World!"

test :: Int =
    5 + sum 5 6 + 7

variables :: Int =
    let first = 5 in
    let second = 6 in
    sum first second

sum a b :: (Int Int) -> Int =
    a + b