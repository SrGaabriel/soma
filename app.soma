trait Eq a where
    def {==} :: a -> a -> Bool

def chooseRight :: a -> a -> a
    | lhs rhs => rhs

def {+}(lhs: a, rhs: a) -> a = lhs + rhs

def isZero :: Int -> Bool
    | 0 => true
    | _ => false

instance Eq Int where
    def {==}(x: Int, y: Int) -> Bool = true

data Shape
    = Square
        length :: Int
    | Circle
        radius :: Int

instance Eq Shape where
    def {==} :: Shape -> Shape -> Bool
        | (Circle r1) (Circle r2) => r1 == r2
        | (Square s1) (Square s2) => true
        | _         _             => false

def testSum(x: Int, y: Int) -> Int = x + y

def areNumEqual(num1: Int, num2: Int) -> Bool = num1 == num2

def testShape :: Shape = Circle 5

def polTest(x: String, y: String) -> Bool = x == y

def testTypeVarSolvingLocality(x: String, y: String) -> Bool = x == y

def testSkolem :: a -> a -> Bool
    | left right => left == right

def testNoConstraints :: a -> a -> Bool
    | left right => testSkolem left right

def testPoly :: Bool = "a" == "a"

def experimentChooseRight :: a -> b -> b
    | lhs rhs => rhs

def testChoose :: a -> b -> c
    | lhs rhs => experimentChooseRight lhs rhs