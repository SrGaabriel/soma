use stdlib/collections.{cons, head, length, map, foldl, filter, sum, reverse, append, ==}
use stdlib/core.{println}
use base/core.{display}
use base/prim.{List}

def main : IO () =
    compose
        let xs = [1, 2, 3, 4, 5]

        let len = length xs
        println ("Length: " <> display len)
        println ("Buggy")

        let total = sum xs
        println ("Sum: " <> display total)
        println ("Hello, World!")

        bind x <- println "5"

        let doubled = map (\x -> x * 2) xs
        let doubledSum = sum doubled
        println ("Doubled sum: " <> display doubledSum)

        let evens = filter (\x -> x % 2 == 0) [1, 2, 3, 4, 5, 6]
        let evensSum = sum evens
        println ("Evens sum: " <> display evensSum)

        let rev = reverse [1, 2, 3]
        let revSum = sum rev
        println ("Reverse sum: " <> display revSum)

        let combined = append [1, 2] [3, 4]
        let combinedSum = sum combined
        println ("Append sum: " <> display combinedSum)

        let withZero = List::Cons 0 xs
        let consSum = sum withZero
        println ("Cons sum: " <> display consSum)

        let first = head xs
        println ("Head: " <> display first)

        println "Done!"
