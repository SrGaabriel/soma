cabal-version: 3.12
name: soma-lsp
version: 0.1.0.0
license: MIT
license-file: ../LICENSE
author: Gabriel
maintainer: gabriel@minatel.dev
category: Programming Language
build-type: Simple

common warnings
  ghc-options:
    -Wall
    -fprof-auto
    -rtsopts

executable soma-lsp
  import: warnings
  main-is: Server.hs
  hs-source-dirs: app
  build-depends:
    base,
    containers,
    directory >=1.3,
    filepath,
    lens >=5.3,
    lsp >=2.7,
    lsp-types >=2.3,
    mtl >=2.3,
    soma,
    stm >=2.5,
    text,

  default-language: Haskell2010

test-suite soma-lsp-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test
  build-depends:
    base,
    data-default >=0.8,
    filepath,
    hspec >=2.11,
    lens,
    lsp,
    lsp-test >=0.17,
    lsp-types,
    parser-combinators >=1.3,
    text,

  default-language: Haskell2010
