use base::prim::{Ptr, Word8, Word32, Int64}
use base::math::{Nat}

record ByteVec (0 n : Nat) where
    data : Ptr Word8
    len  : Int64

@[wired_in "type.string"]
record String where
    {0 codepoints : Nat}
    bytes : ByteVec codepoints

record Char where
    scalar : Word32

record Substring where
    parent : String
    offset : Int64
    length : Int64
