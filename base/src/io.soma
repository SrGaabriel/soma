use base/core.{Functor, Applicative, Monad, >>=}

@[intrinsic]
def pure_io : a -> IO a

instance Functor IO where
    def fmap : (a -> b) -> IO a -> IO b
        | f, ioA => ioA >>= (\x -> pure_io (f x))

instance Applicative IO with (Functor IO) where
    def pure : a -> IO a = pure_io
    def {<*>} : IO (a -> b) -> IO a -> IO b
        | ioF, ioA => ioF >>= (\f -> ioA >>= (\a -> pure_io (f a)))
    def {*>} : IO a -> IO b -> IO b
        | ioA, ioB => ioA >>= (\x -> ioB)
    def {<*} : IO a -> IO b -> IO a
        | ioA, ioB => ioA >>= (\a -> ioB >>= (\b -> pure_io a))

@[intrinsic]
instance Monad IO with (Applicative IO)
