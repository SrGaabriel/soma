@[intrinsic "ffi.null"]
def null : Ptr a

@[intrinsic "ffi.ptr_add"]
def ptr_add : Ptr a -> Int64 -> Ptr a

@[intrinsic "ffi.ptr_diff"]
def ptr_diff : Ptr a -> Ptr a -> Int64

@[intrinsic "ffi.ptr_read"]
def ptr_read : Ptr a -> a

@[intrinsic "ffi.ptr_write"]
def ptr_write : Ptr a -> a -> Unit

@[intrinsic "ffi.ptr_cast"]
def ptr_cast : Ptr a -> Ptr b

alias CChar = Int8
alias CShort = Int16
alias CInt = Int32
alias CLong = Int64
alias CLLong = Int64

alias CUChar = Word8
alias CUShort = Word16
alias CUInt = Word32
alias CULong = Word64
alias CULLong = Word64

alias CSize = Word64
alias CSsize = Int64
alias CPtrdiff = Int64

alias CIntPtr = Int64
alias CUIntPtr = Word64

alias CString = Ptr Word8

@[intrinsic "ffi.to_cstring"]
def to_cstring : String -> CString

@[intrinsic "ffi.from_cstring"]
def from_cstring : CString -> String

@[intrinsic "ffi.cstring_len"]
def cstring_len : CString -> CSize

@[extern]
def malloc : CSize -> Ptr a

@[extern]
def free : Ptr a -> IO Unit

@[extern]
def realloc : Ptr a -> CSize -> Ptr a

@[extern]
def calloc : CSize -> CSize -> Ptr a

export {
    Ptr,
    null,
    ptr_add,
    ptr_diff,
    ptr_read,
    ptr_write,
    ptr_cast,
    CChar,
    CShort,
    CInt,
    CLong,
    CLLong,
    CUChar,
    CUShort,
    CUInt,
    CULong,
    CULLong,
    CSize,
    CSsize,
    CPtrdiff,
    CIntPtr,
    CUIntPtr,
    CString,
    to_cstring,
    from_cstring,
    cstring_len,
    malloc,
    free,
    realloc,
    calloc
}
