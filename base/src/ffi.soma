use base::prim::{Ptr, Int32, Int8, Int16, Int64, Word32, Word8, Word16, Word64, Unit, IO}
use base::string::{String}

@[intrinsic "ffi.null"]
def null : Ptr a

@[intrinsic "ffi.ptr_add"]
def ptr_add : Ptr a -> Int64 -> Ptr a

@[intrinsic "ffi.ptr_diff"]
def ptr_diff : Ptr a -> Ptr a -> Int64

@[intrinsic "ffi.ptr_read"]
def ptr_read : Ptr a -> a

@[intrinsic "ffi.ptr_write"]
def ptr_write : Ptr a -> a -> Unit

@[intrinsic "ffi.ptr_cast"]
def ptr_cast : Ptr a -> Ptr b

alias CChar := Int8
alias CShort := Int16
alias CInt := Int32
alias CLong := Int64
alias CLLong := Int64

alias CUChar := Word8
alias CUShort := Word16
alias CUInt := Word32
alias CULong := Word64
alias CULLong := Word64

alias CSize := Word64
alias CSsize := Int64
alias CPtrdiff := Int64

alias CIntPtr := Int64
alias CUIntPtr := Word64

alias CString := Ptr Word8

@[intrinsic "ffi.from_cstring"]
def from_cstring : CString -> String

@[extern]
def malloc : CSize -> Ptr a

@[extern]
def free : Ptr a -> IO Unit

@[extern]
def realloc : Ptr a -> CSize -> Ptr a

@[extern]
def calloc : CSize -> CSize -> Ptr a
