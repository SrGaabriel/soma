use base::prim::{Int32}
use base::prop::{Eq, cong}
use base::string::{String}
use base::list::{list_append, list_append_assoc}

@[extern "soma_int_to_string"]
def int_to_string : Int32 -> String

@[inline]
def strcat (s1 : String) (s2 : String) : String :=
    String::New (list_append s1.bytes s2.bytes)

theorem strcat_assoc (x : String) (y : String) (z : String) : Eq (strcat x (strcat y z)) (strcat (strcat x y) z) :=
    let append := list_append_assoc x.bytes y.bytes z.bytes
    cong (String::New) (append)

inductive Option (a : Type) where
    | Some (value : a)
    | None

inductive Either (err : Type) (ok : Type) where
    | Err (error : err)
    | Ok (value : ok)

class Display (a : Type) where
    display : a -> String

class Magma (a : Type) where
    {<>} : a -> a -> a

class Semigroup (a : Type) {{m : Magma a}} where
    associative : (x : a) -> (y : a) -> (z : a) -> (x <> (y <> z) = (x <> y) <> z)

class Monoid (a : Type) {{m : Magma a}} {{Semigroup a}} where
    identity : a
    left_identity : (x : a) -> (identity <> x = x)
    right_identity : (x : a) -> (x <> identity = x)

class Functor (f : Type -> Type) where
    fmap : ∀ a b. (a -> b) -> f a -> f b

class Applicative (f : Type -> Type) {{Functor f}} where
    pure : ∀ a. a -> f a
    {<*>} : ∀ a b. f (a -> b) -> f a -> f b
    {*>} : ∀ a b. f a -> f b -> f b
    {<*} : ∀ a b. f a -> f b -> f a

class Monad (m : Type -> Type) {{Applicative m}} where
    {>>=} : ∀ a b. m a -> (a -> m b) -> m b
    {>>} : ∀ a b. m a -> m b -> m b

instance : Functor Option where
    def fmap : (a -> b) -> Option a -> Option b
        | f, (Option::Some value) => Option::Some (f value)
        | _, Option::None => Option::None

instance : Display String where
    def display (s : String) : String :=
        s

instance : Display Int32 where
    def display (n : Int32) : String :=
        int_to_string n

instance : Magma String where
    @[inline]
    def {<>} (s1 : String) (s2 : String) : String :=
        strcat s1 s2

instance : Semigroup String where
    def associative : (x : String) -> (y : String) -> (z : String) -> (x <> (y <> z) = (x <> y) <> z)
        | x, y, z => cong String::New (list_append_assoc x.bytes y.bytes z.bytes)

instance {a : Type} {{d : Display a}} : Display (Option a) where
    def display : Option a -> String
        | Option::Some value => "Some(" <> d.display value <> ")"
        | Option::None => "None"
