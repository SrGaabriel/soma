use base/prim

@[extern "soma_strcat"]
def strcat : String -> String -> String
@[extern "soma_int_to_string"]
def int_to_string : Int -> String

inductive Option {a : Type} where
    | Some (value : a)
    | None

inductive Either {err : Type} {ok : Type} where
    | Err (error : err)
    | Ok (value : ok)

class Display (a : Type) where
    display : a -> String

class Semigroup (a : Type) where
    {<>} : a -> a -> a

class Monoid (a : Type) with (Semigroup a) where
    mempty : a
    mconcat : List a -> a

class Functor (f : Type -> Type) where
    fmap : ∀ a b. (a -> b) -> f a -> f b

class Applicative (f : Type -> Type) with (Functor f) where
    pure : ∀ a. a -> f a
    {<*>} : ∀ a b. f (a -> b) -> f a -> f b
    {*>} : ∀ a b. f a -> f b -> f b
    {<*} : ∀ a b. f a -> f b -> f a

class Monad (m : Type -> Type) with (Applicative m) where
    {>>=} : ∀ a b. m a -> (a -> m b) -> m b
    {>>} : ∀ a b. m a -> m b -> m b

instance : Functor Option where
    def fmap : (a -> b) -> Option a -> Option b
        | f, (Option::Some value) => Option::Some (f value)
        | _, Option::None => Option::None

instance : Display String where
    def display (s : String) : String =
        s

instance : Display Int where
    def display (n : Int) : String =
        int_to_string n

instance : Semigroup String where
    @[inline]
    def {<>} (s1 : String) (s2 : String) : String =
        strcat s1 s2

instance {a : Type} {{d : Display a}} : Display (Option a) where
    def display : Option a -> String
        | Option::Some value => "Some(" <> d.display value <> ")"
        | Option::None => "None"
