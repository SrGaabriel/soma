use base::op::{Add, add, Gt, gt}
use base::prop::{Truth, Never}

inductive Nat where
    | Zero
    | Succ (n : Nat)

instance Add Nat where
    def add : Nat -> Nat -> Nat
        | Nat::Zero, m => m
        | Nat::Succ n, m => Nat::Succ (add n m)

instance Gt Nat where
    def gt : Nat -> Nat -> Type
        | Nat::Zero, Nat::Zero => Truth
        | Nat::Zero, Nat::Succ _ => Never
        | Nat::Succ _, Nat::Zero => Truth
        | Nat::Succ n, Nat::Succ m => gt n m

def succ_greater_than_zero : gt (Nat::Succ Nat::Zero) Nat::Zero := Truth::Trivial
