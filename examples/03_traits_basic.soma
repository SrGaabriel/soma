// Basic trait examples

// Simple trait
trait Eq a where
    def {==} :: a -> a -> Bool

// Trait with multiple methods
trait Show a where
    def show :: a -> String
    def showList :: [a] -> String

// Trait with constraint
trait Ord a with (Eq a) where
    def {<} :: a -> a -> Bool
    def {>} :: a -> a -> Bool

// Instance for built-in type
intrinsic def {==} :: Int -> Int -> Bool

instance Eq Int where
    def {==} :: Int -> Int -> Bool
        | x y => x == y

// Instance for custom type
data Status
    | Active
    | Inactive

instance Eq Status where
    def {==} :: Status -> Status -> Bool
        | (Active) (Active) => True
        | (Inactive) (Inactive) => True
        | _ _ => False

instance Show Status where
    def show :: Status -> String
        | (Active) => "Active"
        | (Inactive) => "Inactive"
