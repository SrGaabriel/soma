// Compose block examples

intrinsic def {+} :: Int -> Int -> Int
intrinsic def println :: a -> IO ()
intrinsic data IO :: * -> *

// Simple compose block
def example1 :: IO () = compose
    let x = 5
    let y = 10
    println (x + y)

// Multiple statements
def example3 :: IO () = compose
    println "Starting"
    let result = 42
    println result
    println "Done"
