// Advanced pattern matching

intrinsic def {+} :: Int -> Int -> Int

data List a
    | Cons
        head :: a
        tail :: List a
    | Nil

// Nested pattern matching
def listLength :: List a -> Int
    | (Nil) => 0
    | (Cons _ tail) => 1 + listLength tail

// Wildcard patterns
def ignoreSecond :: a -> b -> a
    | x _ => x

// Pattern matching with recursion
def processData :: List Int -> Int
    | (Nil) => 0
    | (Cons x (Nil)) => x
    | (Cons x rest) => x + processData rest
