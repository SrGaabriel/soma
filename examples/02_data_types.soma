// Data type examples

// Simple enum
data Color
    | Red
    | Green
    | Blue

// Generic data type
data Maybe a
    | Just
        value :: a
    | Nothing

// Multiple type parameters
data Either a b
    | Left
        leftValue :: a
    | Right
        rightValue :: b

// Nested constructors
data Tree a
    | Leaf
        value :: a
    | Node
        left :: Tree a
        right :: Tree a

// Using constructors
def myMaybe :: Maybe Int
    | => Just 42

def myTree :: Tree Int
    | => Leaf 5
