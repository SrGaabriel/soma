// Test multi-field ADT constructors

intrinsic def {+} :: Int -> Int -> Int

data Pair a b
    | MkPair
        fst :: a
        snd :: b

data Triple a b c
    | MkTriple
        first :: a
        second :: b
        third :: c

// Extract first element from pair
def fst :: Pair Int Int -> Int
    | (MkPair x y) => x

// Extract second element from pair
def snd :: Pair Int Int -> Int
    | (MkPair x y) => y

// Sum all elements in a triple
def sumTriple :: Triple Int Int Int -> Int
    | (MkTriple a b c) => a + b + c

// Test with nested structures
data Box a
    | MkBox
        contents :: a

def unboxPair :: Box (Pair Int Int) -> Int
    | (MkBox p) => fst p

// Swap elements in a pair
def swap :: Pair Int Int -> Pair Int Int
    | (MkPair x y) => MkPair y x
