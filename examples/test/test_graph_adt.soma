// Test ADT constructors and projections in graph mode

intrinsic def {+} :: Int -> Int -> Int

data Pair a b
    | MkPair
        fst :: a
        snd :: b

// Extract and sum both elements from a pair
def sumPair :: Pair Int Int -> Int
    | (MkPair x y) => x + y

def main :: Int = sumPair (MkPair 10 32)
