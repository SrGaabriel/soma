intrinsic def {+} :: Int -> Int -> Int
intrinsic def cons :: a -> [a] -> [a]
intrinsic def pureIO :: Int -> IO Int

def sumFirstTwo :: [Int] -> Int
    | (x:y:_) => x + y
    | [x] => x
    | [] => 0

def main :: IO Int =
    let base = [3, 2, 1] in
    let extended = cons 5 (cons 4 base) in
    let r1 = sumFirstTwo extended in
    let r2 = sumFirstTwo [10] in
    let r3 = sumFirstTwo [] in
    pureIO (r1 + r2 + r3)
