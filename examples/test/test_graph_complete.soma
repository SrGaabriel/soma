// Comprehensive test for graph mode parallelism
// Tests: div/mod, closures, recursion

intrinsic def {+} :: Int -> Int -> Int
intrinsic def {-} :: Int -> Int -> Int
intrinsic def {*} :: Int -> Int -> Int
intrinsic def {/} :: Int -> Int -> Int
intrinsic def {%} :: Int -> Int -> Int
intrinsic def {==} :: a -> a -> Bool

// === Division and Modulo ===

def divMod(a: Int, b: Int) -> Int = (a / b) + (a % b)

def euclidGcd(a: Int, b: Int) -> Int =
    if b == 0 then a else euclidGcd b (a % b)

// === Recursive with closures ===

def sumWithBase(base: Int, n: Int) -> Int =
    if n == 0 then base else compose
        let addBase = (\x -> x + base)
        addBase n + sumWithBase base (n - 1)

// === Parallel tree computation ===

def treeSum(depth: Int) -> Int =
    if depth == 0 then 1 else treeSum (depth - 1) + treeSum (depth - 1)

// === Combined test ===
// Expected: 16 (divMod) + 6 (gcd) + 75 (sumWithBase) + 16 (treeSum) = 113

def main :: Int =
    let divModResult = divMod 100 7 in
    let gcdResult = euclidGcd 48 18 in
    let sumBaseResult = sumWithBase 10 5 in
    let treeResult = treeSum 4 in
    divModResult + gcdResult + sumBaseResult + treeResult
