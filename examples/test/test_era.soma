intrinsic def {+} :: Int -> Int -> Int

def testUnusedClosure(x: Int) -> Int =
    let unused = (\y -> y + 1) in
    x + 10

def testUsedThenDiscarded(x: Int) -> Int =
    let f = (\y -> x + y) in
    let result = f 5 in
    result

def testNestedPartial(x: Int) -> Int =
    let outer = (\a -> (\b -> a + b + x)) in
    let inner = outer 10 in
    inner 5

def main :: Int =
    let r1 = testUnusedClosure 100 in
    let r2 = testUsedThenDiscarded 200 in
    let r3 = testNestedPartial 300 in
    r1 + r2 + r3
