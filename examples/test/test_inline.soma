intrinsic def {+} :: Int -> Int -> Int
intrinsic def {*} :: Int -> Int -> Int

inline def double(x: Int) -> Int = x + x

inline def square(x: Int) -> Int = x * x

def compute(x: Int) -> Int = double (square x)

def applyTwice(f: Int -> Int, x: Int) -> Int = f (f x)

def main :: Int = applyTwice (\y -> y + 1) 5
