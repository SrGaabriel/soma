// Operator examples

intrinsic def {+} :: Int -> Int -> Int
intrinsic def {-} :: Int -> Int -> Int
intrinsic def {*} :: Int -> Int -> Int
intrinsic def {/} :: Int -> Int -> Int
intrinsic def {==} :: Int -> Int -> Bool
intrinsic def {<} :: Int -> Int -> Bool

// Custom operators as functions
def {+++}(x: Int, y: Int) -> Int = (x + y) * 2

def {***}(x: Int, y: Int) -> Int = x * y * y

// Using operators
def calculate(a: Int, b: Int, c: Int) -> Int =
    (a + b) * c

def comparison(x: Int, y: Int) -> Bool =
    x < y

def complexExpr :: Int -> Int
    | n => (n + 1) * (n - 1) / 2
