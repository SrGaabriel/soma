cabal-version: 3.12
name: soma
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: Gabriel
maintainer: gabriel@minatel.dev
category: Programming Language
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -fprof-auto
    -rtsopts

library
  import: warnings
  exposed-modules:
    Alloy.Build
    Alloy.Decisions
    Alloy.Ir
    Alloy.Lower
    Alloy.Monomorphize
    Alloy.Simplify
    Analysis.Symbol
    Config.Options
    Inference.Assembler
    Inference.Core
    Inference.Errors
    Inference.Gen
    Inference.Resolver
    Inference.Solving
    Inference.Substitution
    Inference.Tree
    Lexing.Errors
    Lexing.Lexer
    Lexing.Position
    Llvm.Dependencies
    Llvm.Gen.Arrays
    Llvm.Gen.Bindings
    Llvm.Gen.Calls
    Llvm.Gen.Context
    Llvm.Gen.Core
    Llvm.Gen.DataTypes
    Llvm.Gen.Entry
    Llvm.Gen.Externals
    Llvm.Gen.Functions
    Llvm.Gen.Intrinsics
    Llvm.Gen.Mangling
    Llvm.Gen.Metadata
    Llvm.Gen.Monomorphize
    Llvm.Gen.Panic
    Llvm.Gen.PatternMatch
    Llvm.Gen.Templates
    Llvm.Gen.TypeClasses
    Llvm.Gen.Types
    Llvm.Gen.Value
    Llvm.Gen.Virtual
    Llvm.Instructions
    Llvm.Ir
    Llvm.Modules
    Llvm.Types
    Llvm.Values
    Logging.ErrorPrinter
    Logging.Errors
    Logging.PrettyTrees
    Metal.Expr
    Metal.Function
    Metal.Gen.Binding
    Metal.Gen.Core
    Metal.Gen.DataTypes
    Metal.Gen.Entry
    Metal.Gen.Extracts
    Metal.Gen.Metadata
    Metal.Gen.Patterns
    Metal.Gen.Value
    Metal.Lift
    Metal.Metadata
    Metal.Module
    Parsing.Ast
    Parsing.Atoms
    Parsing.Bindings
    Parsing.Errors
    Parsing.Parser
    Parsing.Patterns
    Parsing.Types
    Project.Graph
    Project.Metadata
    Project.Module
    Project.Parsing
    Project.Processing
    Project.Symbols
    Project.Tarball
    Syntax.Ops
    Syntax.Patterns
    Syntax.Tree
    Typing.Currying
    Typing.Types
    Utils.Lists

  hs-source-dirs: src
  build-depends:
    aeson >=2.2.3.0,
    ansi-terminal >=1.0,
    async >=2.2.5,
    base >=4.19.2.0,
    bytestring >=0.12.0.0,
    containers >=0.6,
    directory >=1.3.8.3,
    filepath >=1.5.2.0,
    hashable >=1.5.0.0,
    mtl >=2.2,
    optparse-applicative >=0.19.0.0,
    process >=1.6,
    tar >=0.7.0.0,
    zlib >=0.7.0.0,

  default-language: Haskell2010

executable soma
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    ansi-terminal,
    async,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    hashable,
    mtl,
    optparse-applicative,
    process,
    soma,
    tar,
    zlib,

  default-language: Haskell2010
