cabal-version: 3.14
name: soma
version: 0.1.0.0
license: Apache-2.0
license-file: LICENSE
author: Gabriel
maintainer: gabriel@minatel.dev
category: Programming Language
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -fprof-auto
    -rtsopts

library
  import: warnings
  exposed-modules:
    Soma
    Soma.Diagnostic
    Soma.File
    Soma.Print
    Soma.Syntax.Kind
    Soma.Syntax.Lexer
    Soma.Syntax.Parser
    Soma.Syntax.Tree
    Soma.Util

  build-depends:
    Blammo ^>=2.1,
    base ^>=4.22,
    containers ^>=0.8,
    diagnose,
    directory ^>=1.3.11,
    filepath ^>=1.5.5,
    hashable ^>=1.5.1.0,
    maple,
    mtl ^>=2.3.1,
    symbolize ^>=1.0.3,
    text ^>=2.1,
    text-rope ^>=0.3,
    unordered-containers ^>=0.2,
    vector ^>=0.13.1

  default-extensions:
    Strict
    StrictData

  ghc-options:
    -Wno-orphans

  hs-source-dirs: compiler/lib
  default-language: GHC2024

executable soma
  import: warnings
  main-is: Main.hs
  build-depends:
    base ^>=4.22,
    optparse-applicative ^>=0.19,
    soma

  other-modules:
    Somac.Cli

  default-extensions:
    Strict
    StrictData

  hs-source-dirs: compiler/app
  default-language: GHC2024

test-suite soma-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    Blammo,
    base,
    directory,
    filepath,
    hspec,
    maple,
    mtl,
    soma,
    symbolize,
    text,
    vector

  other-modules:
    Lexer
    Parser

  hs-source-dirs: compiler/test
  default-language: Haskell2010
