cabal-version: 3.12
name: soma
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: Gabriel
maintainer: gabriel@minatel.dev
category: Programming Language
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -fprof-auto
    -rtsopts

library
  import: warnings
  exposed-modules:
    Alloy.Build
    Alloy.CSE
    Alloy.Decisions
    Alloy.Defunc
    Alloy.DictUtils
    Alloy.DictionaryPass
    Alloy.ExpandIntrinsics
    Alloy.HoistAllocas
    Alloy.Ir
    Alloy.Lower
    Alloy.MonadicInline
    Alloy.Monomorphize
    Alloy.Naming
    Alloy.PromoteRefs
    Alloy.ReaderRewrite
    Alloy.Simplify
    Alloy.Subst
    Alloy.Uniqueness
    Alloy.Verify
    Analysis.Symbol
    Config.Options
    Inference.Assembler
    Inference.Core
    Inference.Errors
    Inference.Gen
    Inference.Resolver
    Inference.Solving
    Inference.Substitution
    Inference.Tree
    Lexing.Errors
    Lexing.Lexer
    Lexing.Position
    Llvm.Dependencies
    Llvm.Gen.Core
    Llvm.Gen.Dictionary
    Llvm.Gen.Entry
    Llvm.Gen.Function
    Llvm.Gen.Instr
    Llvm.Gen.Intrinsics
    Llvm.Gen.Op
    Llvm.Gen.OperandPass
    Llvm.Gen.Operands
    Llvm.Gen.Templates
    Llvm.Gen.TypeConversion
    Llvm.Instructions
    Llvm.Ir
    Llvm.Modules
    Llvm.Types
    Llvm.Values
    Logging.ErrorPrinter
    Logging.Errors
    Logging.PrettyTrees
    Metal.Expr
    Metal.Function
    Metal.Gen.Binding
    Metal.Gen.Core
    Metal.Gen.DataTypes
    Metal.Gen.Entry
    Metal.Gen.Extracts
    Metal.Gen.Metadata
    Metal.Gen.Patterns
    Metal.Gen.Value
    Metal.Lift
    Metal.Metadata
    Metal.Module
    Metal.MonadNormalize
    Metal.MonadProfile
    Parsing.Ast
    Parsing.Atoms
    Parsing.Bindings
    Parsing.Errors
    Parsing.Parser
    Parsing.Patterns
    Parsing.Types
    Project.Graph
    Project.Incremental
    Project.Metadata
    Project.Module
    Project.Parsing
    Project.Symbols
    Project.Tarball
    Syntax.Ops
    Syntax.Patterns
    Syntax.Tree
    Typing.Currying
    Typing.Types
    Utils.Lists

  hs-source-dirs: src
  build-depends:
    aeson >=2.2.3.0,
    ansi-terminal >=1.0,
    async >=2.2.5,
    base >=4.19.2.0,
    binary >=0.8,
    bytestring >=0.12.0.0,
    containers >=0.6,
    cryptohash-sha256 >=0.11,
    directory >=1.3.8.3,
    filepath >=1.5.2.0,
    hashable >=1.5.0.0,
    mtl >=2.2,
    optparse-applicative >=0.19.0.0,
    process >=1.6,
    tar >=0.7.0.0,
    time >=1.8,
    zlib >=0.7.0.0,
    parser-combinators >=1.3,

  default-language: Haskell2010

executable soma
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    ansi-terminal,
    async,
    base,
    binary,
    bytestring,
    containers,
    cryptohash-sha256,
    directory,
    filepath,
    hashable,
    mtl,
    optparse-applicative,
    process,
    soma,
    tar,
    time,
    zlib,

  default-language: Haskell2010
