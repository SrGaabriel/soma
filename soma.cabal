cabal-version:      3.12
name:               soma
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             Gabriel
maintainer:         gabriel@minatel.dev
-- copyright:
category:           Programming Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable soma
    import:           warnings
    main-is:          Main.hs
    other-modules:    Lexing.Lexer
                      Lexing.Errors
                      Lexing.Position
                      Parsing.Errors
                      Parsing.Parser
                      Parsing.Ast
                      Parsing.Bindings
                      Parsing.Types
                      Parsing.Atoms
                      Logging.ErrorPrinter
                      Logging.Reporting
                      Project.Module
                      Syntax.Tree
                      Syntax.Ops
                      Utils.Lists
                      Config.Options
                      Typing.Types
                      Typing.Currying

    build-depends:    base >= 4.19.2.0,
                      ansi-terminal >= 1.0,
                      containers >= 0.6,
                      mtl >= 2.2,
    hs-source-dirs:   app
    default-language: Haskell2010
