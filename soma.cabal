cabal-version: 3.14
name: soma
version: 0.1.0.0
license: Apache-2.0
license-file: LICENSE
author: Gabriel
maintainer: gabriel@minatel.dev
category: Programming Language
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -fprof-auto
    -rtsopts

library
  import: warnings
  exposed-modules:
    Soma
    Soma.Util
    Soma.Diagnostic
    Soma.Syntax.Kind
    Soma.Syntax.Lexer
    Soma.Syntax.Parser

  build-depends:
    base ^>=4.20.2.0,
    hashable ^>=1.5.1.0,
    maple,
    mtl ^>=2.3.1,
    symbolize ^>=1.0.3,
    text ^>=2.1,
    text-rope ^>=0.3,
    unordered-containers >=0.2.21,
    vector ^>=0.13.1

  hs-source-dirs: compiler/lib
  default-language: Haskell2010

executable soma
  import: warnings
  main-is: Main.hs
  build-depends:
    base ^>=4.20.2.0,
    optparse-applicative ^>=0.19,
    soma

  other-modules:
    Somac.Cli

  hs-source-dirs: compiler/app
  default-language: Haskell2010

test-suite soma-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base ^>=4.20.2.0,
    hspec ^>=2.11,
    maple,
    mtl ^>=2.3.1,
    soma,
    text ^>=2.1

  other-modules:
    Lexer

  hs-source-dirs: compiler/test
  default-language: Haskell2010
