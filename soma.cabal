cabal-version: 3.12
name: soma
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: Gabriel
maintainer: gabriel@minatel.dev
category: Programming Language
build-type: Simple

common warnings
  ghc-options:
    -Wall
    -fprof-auto
    -rtsopts

--    -fplugin=LiquidHaskell
library
  import: warnings
  exposed-modules:
    Format.Errors
    Format.Trees
    Inference.Assembler
    Inference.Core
    Inference.Errors
    Inference.Gen
    Inference.InstanceValidation
    Inference.Naming
    Inference.Resolver
    Inference.Solving
    Inference.Substitution
    Inference.Tree
    Lexing.Errors
    Lexing.Lexer
    Lexing.Position
    Metal.Expr
    Metal.Function
    Metal.Gen.Entry
    Metal.Gen.Metadata
    Metal.Lift
    Metal.Lower
    Metal.Metadata
    Metal.Module
    Metal.MonadNormalize
    Metal.MonadProfile
    Parsing.Ast
    Parsing.Atoms
    Parsing.Attributes
    Parsing.Bindings
    Parsing.Cst.Atoms
    Parsing.Cst.Declarations
    Parsing.Cst.Helpers
    Parsing.Cst.Parser
    Parsing.Cst.Patterns
    Parsing.Cst.Types
    Parsing.CstBuilder
    Parsing.DataTypes
    Parsing.Errors
    Parsing.Imports
    Parsing.Intrinsics
    Parsing.Parser
    Parsing.Patterns
    Parsing.Traits
    Parsing.Types
    Project.Check
    Project.Extracts
    Project.Graph
    Project.Module
    Project.Name
    Project.Parsing
    Project.Symbols
    Project.Unique
    Syntax.CST.GreenTree
    Syntax.CST.Lower
    Syntax.CST.RedTree
    Syntax.CST.SyntaxKind
    Syntax.Ops
    Syntax.Patterns
    Syntax.Tree
    Typing.Currying
    Typing.Types
    Utils.Lists

  hs-source-dirs: compiler/lib
  build-depends:
    async >=2.2.5,
    base >=4.19.2.0,
    bytestring >=0.12.0.0,
    containers >=0.6,
    directory >=1.3.8.3,
    filepath >=1.5.2.0,
    hashable >=1.4,
    liquidhaskell ==0.9.12.2,
    megaparsec >=9.7,
    mtl >=2.2,
    text >=2.1,
    unordered-containers >=0.2,

  default-language: Haskell2010

test-suite soma-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs:
    compiler/test
    compiler/exe

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    QuickCheck >=2.14,
    base,
    containers,
    directory,
    filepath,
    hspec >=2.11,
    hspec-discover >=2.11,
    mtl,
    process,
    soma,
    text,

  other-modules:
    Alloy.Build
    Alloy.Ir
    Alloy.Monomorphize
    Circuit.Ir
    Circuit.Linearize
    Integration.E2ESpec
    Integration.GoldenSpec
    Property.LexerSpec
    Property.LinearizationSpec
    Property.ParserSpec
    Test.Generators
    Test.Utils
    Unit.Alloy.MonomorphizeSpec
    Unit.Circuit.LinearizeSpec
    Unit.Inference.GenSpec
    Unit.Inference.ResolverSpec
    Unit.Inference.SolvingSpec
    Unit.Lexing.LexerSpec
    Unit.Parsing.ParserSpec
    Validation.CircuitSpec

  default-language: Haskell2010

executable somac
  import: warnings
  main-is: Main.hs
  hs-source-dirs: compiler/exe
  build-depends:
    aeson >=2.2.3.0,
    ansi-terminal >=1.0,
    async,
    base,
    binary >=0.8,
    bytestring,
    containers,
    cryptohash-sha256 >=0.11,
    directory,
    filepath,
    hashable,
    liquidhaskell,
    mtl,
    optparse-applicative >=0.19.0.0,
    process,
    soma,
    tar >=0.7.0.0,
    text,
    zlib >=0.7.0.0,

  other-modules:
    Alloy.Build
    Alloy.CSE
    Alloy.Defunc
    Alloy.ExpandIntrinsics
    Alloy.HoistAllocas
    Alloy.Inline
    Alloy.Ir
    Alloy.MonadicInline
    Alloy.Monomorphize
    Alloy.PromoteRefs
    Alloy.ReaderRewrite
    Alloy.Simplify
    Alloy.Subst
    Alloy.Uniqueness
    Build.Incremental
    Build.Metadata
    Build.Tarball
    Circuit.Alloc
    Circuit.Constants
    Circuit.Decisions
    Circuit.Escape
    Circuit.Ir
    Circuit.Linearize
    Circuit.Lower
    Circuit.Parallel
    Circuit.Simplify
    Circuit.ToAlloy
    Circuit.ToGraph
    Circuit.Validate
    Config.Options
    Llvm.Dependencies
    Llvm.Gen.Attributes
    Llvm.Gen.CRuntime
    Llvm.Gen.Core
    Llvm.Gen.Entry
    Llvm.Gen.Externals
    Llvm.Gen.Function
    Llvm.Gen.Instr
    Llvm.Gen.Intrinsics
    Llvm.Gen.Op
    Llvm.Gen.OperandPass
    Llvm.Gen.Operands
    Llvm.Gen.Templates
    Llvm.Gen.TypeConversion
    Llvm.Instructions
    Llvm.Ir
    Llvm.Modules
    Llvm.Types
    Llvm.Values
    Logging.Errors
    Logging.Json
    Logging.Trees
    Orphans.Binary

  default-language: Haskell2010
